    },
    {
      "id": "CH02_S01_A",
      "chapterId": "CH02",
      "title": "",
      "blocks": [
        {
          "id": "BLK_CH02_S01_A_01",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “돈 때문에 다퉜습니까?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 358,
            "lineEnd": 358,
            "stableBlockId": "SRC_CH02_S01_A_01"
          }
        },
        {
          "id": "BLK_CH02_S01_A_02",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “돈이 끝이었으면 좋았겠죠.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 360,
            "lineEnd": 360,
            "stableBlockId": "SRC_CH02_S01_A_02"
          }
        },
        {
          "id": "BLK_CH02_S01_A_03",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “얼마입니까?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 362,
            "lineEnd": 362,
            "stableBlockId": "SRC_CH02_S01_A_03"
          }
        },
        {
          "id": "BLK_CH02_S01_A_04",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “장부 드리겠습니다. 제 계좌로 나간 건 숨기지 않을게요.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 364,
            "lineEnd": 364,
            "stableBlockId": "SRC_CH02_S01_A_04"
          }
        },
        {
          "id": "BLK_CH02_S01_A_05",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "장부에는 여러 해의 이체가 있었다. 단순한 오늘의 분쟁보다 오래된 관계였다."
          },
          "completionEffectIds": [
            "FX_CH02_REVEAL_C03_A_NOTE"
          ],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 366,
            "lineEnd": 366,
            "stableBlockId": "SRC_CH02_S01_A_05"
          }
        }
      ],
      "choices": [],
      "entryEffectIds": [],
      "nextSceneId": "CH02_S02",
      "source": {
        "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
        "sourcePath": "source/마지막_확인_전체_시나리오.md",
        "lineStart": 357,
