            "lineStart": 354,
            "lineEnd": 354,
            "stableBlockId": "SRC_C03_A"
          }
        },
        {
          "id": "C03_B",
          "label": "경비에게 기록에 관한 질문을 그대로 재현하게 한다.",
          "resultSceneId": "CH02_S01_B",
          "effectIds": [
            "FX_C03_B"
          ],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 355,
