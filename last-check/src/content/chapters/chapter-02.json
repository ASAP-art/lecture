          }
        },
        {
          "id": "BLK_CH02_S02_10",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "준석: “여기는 걷는 길이 돌아갑니다. A3 고정 전화 자리에서 위험 구역 밖까지, 빨라도 90초는 잡아야 해요.”"
          },
          "speakerId": "CHAR_JUNSEOK",
          "completionEffectIds": [],
          "source": {
