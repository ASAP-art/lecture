            "stableBlockId": "SRC_CH09_S02_B_03"
          }
        },
        {
          "id": "BLK_CH09_S02_B_04",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “하세요.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
