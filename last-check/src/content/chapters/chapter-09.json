          }
        },
        {
          "id": "BLK_CH09_S02_07",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "이경은 대답하지 않았다. 부정하는 표정도 아니었다."
          },
          "completionEffectIds": [],
          "source": {
