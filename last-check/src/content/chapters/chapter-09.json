        {
          "id": "BLK_CH09_S02_05",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “경비실은 제 자리가 아니고, 원본도 제 종이가 아니니까.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
