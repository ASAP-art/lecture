      "blocks": [
        { "id": "BLK_CH01_S02_A_01", "kind": "dialogue", "content": { "type": "fixed", "text": "서진: “열쇠를 쓴 시각과 목적부터 말씀하세요. 살인 여부는 그다음입니다.”" }, "speakerId": "CHAR_SEOJIN", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 310, "lineEnd": 310, "stableBlockId": "SRC_CH01_S02_A_01" } },
        { "id": "BLK_CH01_S02_A_02", "kind": "dialogue", "content": { "type": "fixed", "text": "이경: “7시 37분쯤. 점검 서명을 하려고요.”" }, "speakerId": "CHAR_IKYEONG", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 312, "lineEnd": 312, "stableBlockId": "SRC_CH01_S02_A_02" } },
        { "id": "BLK_CH01_S02_A_03", "kind": "dialogue", "content": { "type": "fixed", "text": "서진: “다시 기계실에 간 적도 있습니까?”" }, "speakerId": "CHAR_SEOJIN", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 314, "lineEnd": 314, "stableBlockId": "SRC_CH01_S02_A_03" } },
        { "id": "BLK_CH01_S02_A_04", "kind": "dialogue", "content": { "type": "fixed", "text": "이경: “있습니다.”" }, "speakerId": "CHAR_IKYEONG", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 316, "lineEnd": 316, "stableBlockId": "SRC_CH01_S02_A_04" } },
