        { "id": "BLK_CH01_S02_B_01", "kind": "dialogue", "content": { "type": "fixed", "text": "이경: “제가 죽였다고 하면, 아들 쪽은 끝나는 겁니까?”" }, "speakerId": "CHAR_IKYEONG", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 323, "lineEnd": 323, "stableBlockId": "SRC_CH01_S02_B_01" } },
        { "id": "BLK_CH01_S02_B_02", "kind": "dialogue", "content": { "type": "fixed", "text": "서진: “그런 거래는 없습니다.”" }, "speakerId": "CHAR_SEOJIN", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 325, "lineEnd": 325, "stableBlockId": "SRC_CH01_S02_B_02" } },
        { "id": "BLK_CH01_S02_B_03", "kind": "dialogue", "content": { "type": "fixed", "text": "이경: “알겠습니다. 그럼 질문하신 것만 답하죠.”" }, "speakerId": "CHAR_IKYEONG", "completionEffectIds": [], "source": { "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336", "sourcePath": "source/마지막_확인_전체_시나리오.md", "lineStart": 327, "lineEnd": 327, "stableBlockId": "SRC_CH01_S02_B_03" } },
