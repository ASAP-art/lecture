            "stableBlockId": "SRC_CH06_S02_C_05"
          }
        },
        {
          "id": "BLK_CH06_S02_C_06",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "그녀는 지후의 이름을 말하지 않았다."
          },
