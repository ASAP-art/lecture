            "stableBlockId": "SRC_CH06_S02_C_02"
          }
        },
        {
          "id": "BLK_CH06_S02_C_03",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “사고 난 다음이요.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 985,
            "lineEnd": 985,
            "stableBlockId": "SRC_CH06_S02_C_03"
          }
        },
        {
          "id": "BLK_CH06_S02_C_04",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “왜 물음표를 썼죠?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
