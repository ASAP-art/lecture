          }
        },
        {
          "id": "BLK_CH06_S02_C_05",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “남겠다고 했는데, 아무도 없다고 했으니까요.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
