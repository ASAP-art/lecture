          }
        },
        {
          "id": "BLK_CH04_S02_B_03",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “태오 씨를 봤습니까?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 697,
            "lineEnd": 697,
            "stableBlockId": "SRC_CH04_S02_B_03"
          }
        },
        {
          "id": "BLK_CH04_S02_B_04",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “안에 있겠다고 했습니다.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 699,
            "lineEnd": 699,
            "stableBlockId": "SRC_CH04_S02_B_04"
          }
        },
        {
          "id": "BLK_CH04_S02_B_05",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “기계가 움직이는 걸 직접 봤습니까?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 701,
            "lineEnd": 701,
            "stableBlockId": "SRC_CH04_S02_B_05"
          }
        },
        {
          "id": "BLK_CH04_S02_B_06",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “소리는 들었어요.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 703,
