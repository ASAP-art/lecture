    {
      "id": "CH04_S02",
      "chapterId": "CH04",
      "title": "자백과 원본",
      "blocks": [
        {
          "id": "BLK_CH04_S02_01",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "도현이 증거함을 열었다. 갈색 봉투가 다른 서류보다 두꺼웠다. 이경이 의자를 뒤로 밀었다."
          },
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 656,
            "lineEnd": 656,
            "stableBlockId": "SRC_CH04_S02_01"
          }
        },
        {
          "id": "BLK_CH04_S02_02",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “제가 움직였습니다.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 658,
            "lineEnd": 658,
            "stableBlockId": "SRC_CH04_S02_02"
          }
        },
        {
          "id": "BLK_CH04_S02_03",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “서가를요?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 660,
            "lineEnd": 660,
            "stableBlockId": "SRC_CH04_S02_03"
          }
        },
        {
          "id": "BLK_CH04_S02_04",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “네. 제가 열쇠를 썼어요. 돈도 요구받았고. 더 필요한 게 있습니까?”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
