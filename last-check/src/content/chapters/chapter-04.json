        {
          "id": "BLK_CH04_S02_A_02",
          "kind": "document",
          "content": {
            "type": "fixed",
            "text": "**19:37:20 — AUTO 복귀 / 19:40:00 — 예약 이동 / 19:46:02 — HAND 변경, 이동 신호 없음**"
          },
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
