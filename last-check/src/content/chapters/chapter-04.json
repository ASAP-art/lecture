          "id": "BLK_CH04_S02_A_01",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "분석 화면에 같은 사건번호의 세 줄이 떴다."
          },
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
