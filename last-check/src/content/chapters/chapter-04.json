    {
      "id": "CH04_S01_A",
      "chapterId": "CH04",
      "title": "",
      "blocks": [
        {
          "id": "BLK_CH04_S01_A_01",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "지후: “이경 선생님, 은서 씨, 기사님은 직접 봤고요.”"
          },
          "speakerId": "CHAR_JIHU",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 626,
            "lineEnd": 626,
            "stableBlockId": "SRC_CH04_S01_A_01"
          }
        },
        {
          "id": "BLK_CH04_S01_A_02",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “태오 씨는?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 628,
            "lineEnd": 628,
            "stableBlockId": "SRC_CH04_S01_A_02"
          }
        },
        {
          "id": "BLK_CH04_S01_A_03",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "지후: “……나간 줄 알았어요.”"
          },
          "speakerId": "CHAR_JIHU",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 630,
            "lineEnd": 630,
            "stableBlockId": "SRC_CH04_S01_A_03"
          }
        },
        {
          "id": "BLK_CH04_S01_A_04",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “직접 본 세 명과 추측한 한 명을 같은 칸에 썼군요.”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 632,
            "lineEnd": 632,
            "stableBlockId": "SRC_CH04_S01_A_04"
          }
        },
        {
          "id": "BLK_CH04_S01_A_05",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “그걸로 죽였다는 건 아니잖습니까.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [
            "FX_CH04_REVEAL_C08_A_NOTE"
          ],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 634,
            "lineEnd": 634,
            "stableBlockId": "SRC_CH04_S01_A_05"
          }
        }
      ],
      "choices": [],
      "entryEffectIds": [],
      "nextSceneId": "CH04_S02",
      "source": {
        "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
        "sourcePath": "source/마지막_확인_전체_시나리오.md",
        "lineStart": 625,
