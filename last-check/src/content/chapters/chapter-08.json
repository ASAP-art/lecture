          "id": "BLK_CH08_S03_C_02",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "도현: “알겠습니다. 지목과 입증은 따로 판단하죠.”"
          },
          "speakerId": "CHAR_DOHYEON",
          "completionEffectIds": [],
