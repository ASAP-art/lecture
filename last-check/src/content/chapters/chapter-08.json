          "content": {
            "type": "fixed",
            "text": "서진: “이경의 열쇠, 동기, 자백을 중심으로 작성합시다.”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
