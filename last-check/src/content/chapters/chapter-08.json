            "stableBlockId": "SRC_CH08_S03_B_02"
          }
        },
        {
          "id": "BLK_CH08_S03_B_03",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "이경은 대답하지 않았다. 손가락 사이에서 코트 단추가 돌았다."
          },
          "completionEffectIds": [
            "FX_REVEAL_NOTE_CH08_S03_B"
