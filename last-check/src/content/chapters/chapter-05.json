        {
          "id": "BLK_CH05_S01_C_01",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “누가 무엇을 적었는지, 지후가 몰랐으면 했어요.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
