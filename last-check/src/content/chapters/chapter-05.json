    {
      "id": "CH05_S03",
      "chapterId": "CH05",
      "title": "퍼즐 1: 네 명의 집합",
      "blocks": [
        {
          "id": "BLK_CH05_S03_01",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "수첩에 두 줄을 따로 적었다."
          },
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
