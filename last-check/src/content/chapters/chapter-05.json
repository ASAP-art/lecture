            "lineEnd": 767,
            "stableBlockId": "SRC_CH05_S01_C_01"
          }
        },
        {
          "id": "BLK_CH05_S01_C_02",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "서진: “지금도요?”"
          },
          "speakerId": "CHAR_SEOJIN",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 769,
            "lineEnd": 769,
            "stableBlockId": "SRC_CH05_S01_C_02"
          }
        },
        {
          "id": "BLK_CH05_S01_C_03",
          "kind": "dialogue",
          "content": {
            "type": "fixed",
            "text": "이경: “이제는 제가 바랄 수 있는 일이 아니죠.”"
          },
          "speakerId": "CHAR_IKYEONG",
          "completionEffectIds": [],
          "source": {
            "sourceHash": "66e7358249200fd6624e03f7f818a9c1a0f434cb3ca032c3ef1c89b148fa7336",
            "sourcePath": "source/마지막_확인_전체_시나리오.md",
            "lineStart": 771,
            "lineEnd": 771,
            "stableBlockId": "SRC_CH05_S01_C_03"
          }
        },
        {
          "id": "BLK_CH05_S01_C_04",
          "kind": "narration",
          "content": {
            "type": "fixed",
            "text": "그녀는 무릎 위에서 손톱으로 봉투 끝을 접었다. 이미 뜯긴 수령 봉투였다."
          },
          "completionEffectIds": [
            "FX_REVEAL_NOTE_CH05_S01_C"
          ],
