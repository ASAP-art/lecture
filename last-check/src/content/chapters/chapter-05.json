          }
        },
        {
          "id": "C10_B",
          "label": "지후에게 메시지를 읽은 뒤 작성한 문서를 묻는다.",
          "resultSceneId": "CH05_S01_B",
          "effectIds": [
            "FX_C10_B"
          ],
