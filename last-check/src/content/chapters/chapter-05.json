            "stableBlockId": "SRC_CH05_S01_12"
          }
        }
      ],
      "choices": [
        {
          "id": "C10_A",
          "label": "은서에게 원본이 실제로 모두 위험했는지 묻는다.",
          "resultSceneId": "CH05_S01_A",
          "effectIds": [
            "FX_C10_A"
          ],
          "source": {
