{
  "name": "last-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <27",
    "npm": ">=10 <12"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/validate-content.ts",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "test": "npm run content:validate && npm run test:unit",
    "build": "npm run typecheck && npm run content:validate && vite build",
    "preview": "vite preview",
    "review:package": "tsx scripts/package-review.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
